{
  "name": "@openparking-ai/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Open Parking AI admin — the garage owner's screens",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "check-plain-words": "node scripts/check-plain-words.js",
    "check-readable-text": "node scripts/check-readable-text.js",
    "check-languages-match": "node scripts/check-languages-match.js",
    "check-contrast": "node scripts/check-contrast.js",
    "check-old-colours": "node scripts/check-old-colours.js",
    "check-browser": "node scripts/check-browser.js",
    "check-page-stays-home": "node scripts/check-page-stays-home.js",
    "check-no-source-maps": "node scripts/check-no-source-maps.js",
    "check-home-claims": "node scripts/check-home-claims.js",
    "check-descriptions": "node scripts/check-descriptions.js",
    "check-files": "node scripts/check-files.js",
    "check-downloads": "node scripts/check-downloads.js",
    "check-pdf-words": "node scripts/check-pdf-words.js",
    "check-print": "node scripts/check-print.js",
    "check-drawings": "node scripts/check-drawings.js",
    "check-drawings-browser": "node scripts/check-drawings-browser.js",
    "check-removed-person": "node scripts/check-removed-person.js",
    "check-first-load": "node scripts/check-first-load.js",
    "fail-controls": "node scripts/fail-controls.js",
    "fail-controls-browser": "node scripts/fail-controls.js --browser",
    "check-no-real-data": "node .github/scripts/check-no-real-data.js",
    "check-no-commercial-values": "node .github/scripts/check-no-commercial-values.js",
    "check-no-sibling-names": "node .github/scripts/check-no-sibling-names.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
